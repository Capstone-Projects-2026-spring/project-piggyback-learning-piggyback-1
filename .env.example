OPENAI_API_KEY="your_openai_key"
ANTHROPIC_API_KEY="your_anthropic_key"
GEMINI_API_KEY="your_gemini_key"
YOUTUBE_API_KEY="your_youtube_key"
ADMIN_PASSWORD="admin123"
SESSION_SECRET="change-this-session-secret"

# Optional: shared storage root for Railway or other hosted deploys
APP_STORAGE_ROOT="/data"

# Optional: bundled sample videos to copy into shared storage on first boot
PRELOAD_DOWNLOAD_IDS="IxX_QHay02M,jzWPkKvO7v4"

# Optional: Hume AI voice keys
HUME_API_KEY="your_hume_api_key"
HUME_VOICE_BLOSSOM="your_blossom_voice_id"
HUME_VOICE_PIPPA="your_pippa_voice_id"
HUME_VOICE_ASH="your_ash_voice_id"

# Optional: Netscape-format cookies file for restricted YouTube videos
YTDLP_COOKIEFILE="C:\\path\\to\\cookies.txt"
YTDLP_COOKIES_FILE="C:\\path\\to\\cookies.txt"

# Optional: browser-first auth mode for protected YouTube downloads
YTDLP_AUTH_MODE="auto"

# Optional: browser User-Agent for hard protected-video cases
YTDLP_USER_AGENT="Mozilla/5.0 ..."
