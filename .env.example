# Rename this file to .env and fill in with your own values

# AI API Keys (at least one required)
OPENAI_API_KEY = "your_openai_api_key_here"
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"
GEMINI_API_KEY = "your_gemini_api_key_here"

# YOUTUBE Data API Key
YOUTUBE_API_KEY = "your_youtube_api_key_here"

# App Passwords (set to admin123/expert123 by default)
ADMIN_PASSWORD = "admin123"
EXPERT_PASSWORD = "expert123"

# OPTIONAL: Path to a Netscape-format cookies file for downloading restricted Youtube videos
YTDLP_COOKIEFILE="C:\\path\\to\\your\\cookies.txt"
YTDLP_COOKIES_FILE="C:\\path\\to\\your\\cookies.txt"